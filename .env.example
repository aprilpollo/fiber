APP_NAME=AprilPollo
APP_VERSION=1.0.0
API_PORT=3000
API_SHUTDOWN_TIMEOUT_SECONDS=30
ALLOWED_CREDENTIAL_ORIGINS=*
LOG_LEVEL=info
TIME_ZONE=Asia/Bangkok

POSTGRE_URI=postgres://aprilpollo:aprilpollo@postgres:5432/aprilpollo
POSTGRE_URI_MIGRATION=postgres://aprilpollo:aprilpollo@localhost:5432/aprilpollo
POSTGRE_MAX_IDLE_CONNS=2
POSTGRE_MAX_OPEN_CONNS=10
POSTGRE_CONN_MAX_LIFETIME=300

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
